# ==========================================
# Startup Radar India - Environment Variables
# ==========================================

# Port & Environment
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Supabase PostgreSQL Database (Use Session Pooler or Transaction Pooler URL)
# Example: postgresql://postgres.mhviazglxeeaizjdrrql:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.mhviazglxeeaizjdrrql:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Upstash Serverless Redis (for BullMQ queues & caching)
# Example: rediss://default:[YOUR-TOKEN]@optimum-starfish-132990.upstash.io:6379
REDIS_URL="rediss://default:[YOUR-TOKEN]@optimum-starfish-132990.upstash.io:6379"

# JWT Authentication Secret
JWT_SECRET="startup-radar-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# LLM / AI Integration (Optional for Milestone 1)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
