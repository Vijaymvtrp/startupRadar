datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PUBLIC_VISITOR
  FOUNDER
  ORGANIZER
  ADMIN
}

enum StartupStage {
  EXPLORING_IDEA
  RESEARCH
  PROTOTYPE
  MVP
  FIRST_CUSTOMERS
  REVENUE_GENERATING
  SCALING
}

enum BusinessModel {
  B2B
  B2C
  D2C
  MARKETPLACE
  MANUFACTURING
  SERVICES
  SUBSCRIPTION
  DEEP_TECH_RESEARCH
  SOCIAL_ENTERPRISE
  OTHER
}

enum IndustrySector {
  AGRICULTURE
  HEALTHCARE_LIFESCIENCES
  MANUFACTURING
  FOOD_BEVERAGE
  EDUCATION_EDTECH
  RETAIL_ECOMMERCE
  CONSTRUCTION_REAL_ESTATE
  LOGISTICS_SUPPLY_CHAIN
  CLEAN_ENERGY_CLIMATE
  SOFTWARE_IT
  BIOTECH_PHARMA
  FINTECH
  DEFENSE_AEROSPACE
  MEDIA_ENTERTAINMENT
  CONSUMER_GOODS
  SERVICES_CONSULTING
  OTHER
}

enum StartupNeed {
  FUNDING
  GRANTS
  TENDERS
  INCUBATION
  CLOUD_CREDITS
  SOFTWARE_TOOLS
  FACILITIES_EQUIPMENT
  TESTING_CERTIFICATION
  CO_FOUNDER
  PILOT_OPPORTUNITIES
  CUSTOMERS
  PARTNERSHIPS
  SUPPLIERS
  DISTRIBUTION
  EXPORT_SUPPORT
  OTHER
}

enum OpportunityCategory {
  GOVERNMENT_SCHEME
  GRANT_FUNDING
  INCUBATOR_ACCELERATOR
  STARTUP_EVENT
  PITCH_COMPETITION
  HACKATHON_CHALLENGE
  CORPORATE_INNOVATION
  ENTREPRENEURSHIP_PROGRAM
  TENDER_PROCUREMENT
  RESEARCH_DEVELOPMENT
}

enum GovernmentLevel {
  CENTRAL
  STATE
  LOCAL
  PUBLIC_SECTOR
  NOT_APPLICABLE
}

enum OpportunityBenefitType {
  GRANT
  SUBSIDY
  LOAN
  EQUITY_INVESTMENT
  INCUBATION_SUPPORT
  PROCUREMENT
  OTHER
}

enum ReviewReason {
  SUSPECTED_DUPLICATE
  CONFLICTING_DATA
  UNVERIFIED_GOV_CLAIM
  EXTRACTION_UNCERTAINTY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  NEEDS_REVIEW
  OFFICIALLY_VERIFIED
  UNABLE_TO_VERIFY
  EXPIRED
  CLOSED
  CANCELLED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  REJECTED
  ARCHIVED
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         UserRole        @default(FOUNDER)
  isActive     Boolean         @default(true)
  profile             UserProfile?
  startup             StartupProfile?
  preferences         UserPreference?
  savedOpportunities  SavedOpportunity[]
  savedPerks          SavedPerk[]
  trackedApplications ApplicationTracking[]
  notifications       UserAlertNotification[]
  founderProfile      FounderProfile?
  blockedUsers        BlockedUser[]           @relation("blockedUsers")
  blockedBy           BlockedUser[]           @relation("blockedBy")
  profileReports      ProfileReport[]
  auditLogs           AuditLog[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  location  String?
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model StartupProfile {
  id                  String                    @id @default(uuid())
  userId              String                    @unique
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupName         String?
  tagline             String?
  description         String?
  primaryIndustry     IndustrySector
  businessModel       BusinessModel             @default(B2B)
  stage               StartupStage              @default(EXPLORING_IDEA)
  countryCode         String                    @default("IN")
  stateCode           String?
  city                String?
  isRegisteredCompany Boolean                   @default(false)
  dpiitRecognized     Boolean                   @default(false)
  msmeRegistered      Boolean                   @default(false)
  teamSizeBand        String?
  secondaryIndustries StartupProfileIndustry[]
  needs               StartupProfileNeed[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([primaryIndustry])
  @@index([stage])
  @@index([countryCode, stateCode])
  @@map("startup_profiles")
}

model StartupProfileIndustry {
  id               String         @id @default(uuid())
  startupProfileId String
  startupProfile   StartupProfile @relation(fields: [startupProfileId], references: [id], onDelete: Cascade)
  industry         IndustrySector

  @@unique([startupProfileId, industry])
  @@map("startup_profile_industries")
}

model StartupProfileNeed {
  id               String         @id @default(uuid())
  startupProfileId String
  startupProfile   StartupProfile @relation(fields: [startupProfileId], references: [id], onDelete: Cascade)
  need             StartupNeed

  @@unique([startupProfileId, need])
  @@map("startup_profile_needs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// Source Registry & Data Collection Models (Milestone 2)
// -------------------------------------------------------------

enum SourceCollectionMethod {
  AUTO_DETECT
  API
  RSS
  SITEMAP
  HTML
}

enum SourceHealthStatus {
  NEW
  CONFIGURING
  HEALTHY
  WARNING
  FAILED
  PAUSED
  UNSUPPORTED
}

enum SourcePriority {
  HIGH
  MEDIUM
  LOW
}

enum SourceRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

model Source {
  id                    String                 @id @default(uuid())
  name                  String
  baseUrl               String
  allowedDomains        String[]
  category              OpportunityCategory    @default(GOVERNMENT_SCHEME)
  collectionMethod      SourceCollectionMethod @default(AUTO_DETECT)
  priority              SourcePriority         @default(MEDIUM)
  checkFrequencyMinutes Int                    @default(1440)
  isEnabled             Boolean                @default(true)
  healthStatus          SourceHealthStatus     @default(NEW)
  rateLimitPerMinute    Int                    @default(10)
  countryCode           String                 @default("IN")
  stateCode             String?
  city                  String?
  notes                 String?
  lastCheckedAt         DateTime?
  lastSuccessAt         DateTime?
  lastError             String?
  config                SourceConfig?
  runs                  SourceRun[]
  checks                SourceCheck[]
  opportunitySources    OpportunitySource[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([healthStatus])
  @@index([isEnabled])
  @@index([collectionMethod])
  @@map("sources")
}

model SourceConfig {
  id                   String   @id @default(uuid())
  sourceId             String   @unique
  source               Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  apiEndpoint          String?
  apiHeaders           Json?
  feedUrl              String?
  sitemapUrl           String?
  htmlListingSelector  String?
  htmlTitleSelector    String?
  htmlDeadlineSelector String?
  htmlLinkSelector     String?
  htmlDescSelector     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("source_configs")
}

model SourceRun {
  id              String          @id @default(uuid())
  sourceId        String
  source          Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status          SourceRunStatus @default(RUNNING)
  itemsDiscovered Int             @default(0)
  itemsExtracted  Int             @default(0)
  errorMessage    String?
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  durationMs      Int?

  @@index([sourceId])
  @@index([status])
  @@map("source_runs")
}

model SourceCheck {
  id            String    @id @default(uuid())
  sourceId      String
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url           String
  etag          String?
  lastModified  String?
  contentHash   String?
  statusCode    Int?
  checkStatus   String    @default("SUCCESS")
  lastCheckedAt DateTime  @default(now())
  lastChangedAt DateTime?

  @@index([sourceId, url])
  @@map("source_checks")
}

// -------------------------------------------------------------
// Canonical Opportunities & Deduplication (Milestone 3)
// -------------------------------------------------------------

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
  NOT_SPECIFIED
}

model Opportunity {
  id                      String                            @id @default(uuid())
  slug                    String                            @unique
  title                   String
  summary                 String?
  description             String?
  organizer               String?
  category                OpportunityCategory               @default(GOVERNMENT_SCHEME)
  governmentLevel         GovernmentLevel                   @default(NOT_APPLICABLE)
  departmentName          String?
  countryCode             String                            @default("IN")
  stateCode               String?
  city                    String?
  deliveryMode            DeliveryMode                      @default(NOT_SPECIFIED)
  startupStages           String[]                          @default([])
  industries              String[]                          @default([])
  benefitType             OpportunityBenefitType            @default(GRANT)
  benefitAmountMin        Float?
  benefitAmountMax        Float?
  currency                String                            @default("INR")
  sourcePublishedAt       DateTime?
  eventStartAt            DateTime?
  eventEndAt              DateTime?
  applicationOpenAt       DateTime?
  applicationDeadline     DateTime?
  officialApplicationUrl  String?
  officialNotificationUrl String?
  eligibilitySummary      String?
  verificationStatus      VerificationStatus                @default(PENDING)
  publicationStatus       PublicationStatus                 @default(DRAFT)
  verifiedAt              DateTime?
  verifiedBy              String?
  verificationNotes       String?
  firstSeenAt             DateTime                          @default(now())
  lastSeenAt              DateTime                          @default(now())
  lastCheckedAt           DateTime?
  sources                 OpportunitySource[]
  eligibilityCriteria     OpportunityEligibilityCriterion[]
  savedByUsers            SavedOpportunity[]
  trackedApplications     ApplicationTracking[]
  reviewItems             ReviewQueueItem[]
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@index([category])
  @@index([verificationStatus])
  @@index([publicationStatus])
  @@index([applicationDeadline])
  @@index([countryCode, stateCode])
  @@map("opportunities")
}

model OpportunityEligibilityCriterion {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  criterionType String      @default("GENERAL")
  description   String
  isMandatory   Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
  @@map("opportunity_eligibility_criteria")
}

model OpportunitySource {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceUrl       String
  sourceType      String      @default("PRIMARY")
  contentHash     String?
  isPrimarySource Boolean     @default(true)
  firstSeenAt     DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())

  @@unique([opportunityId, sourceUrl])
  @@index([sourceUrl])
  @@map("opportunity_sources")
}

model ReviewQueueItem {
  id            String       @id @default(uuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reason        ReviewReason
  status        ReviewStatus @default(PENDING)
  reviewerNotes String?
  details       Json?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@index([reason])
  @@map("review_queue_items")
}

// -------------------------------------------------------------
// Milestone 5: Startup Perks & Credits Models
// -------------------------------------------------------------

enum PerkBenefitType {
  CLOUD_CREDITS
  AI_API_CREDITS
  DEVELOPER_TOOL
  FREE_TIER
  FREE_TRIAL
  DISCOUNT
  BUSINESS_SOFTWARE
  INFRASTRUCTURE
  FACILITY_ACCESS
  PARTNER_SERVICE
  OTHER
}

enum PerkProgramStatus {
  ACTIVE
  EXPIRED
  WAITLIST
  CLOSED
}

model PerkProvider {
  id                 String               @id @default(uuid())
  name               String               @unique
  officialDomain     String
  providerType       String               @default("OTHER")
  logoUrl            String?
  verificationStatus VerificationStatus   @default(PENDING)
  programs           StartupPerkProgram[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("perk_providers")
}

model StartupPerkProgram {
  id                  String                      @id @default(uuid())
  providerId          String
  provider            PerkProvider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slug                String                      @unique
  programName         String
  description         String?
  officialProgramUrl  String
  applicationUrl      String?
  benefitType         PerkBenefitType             @default(CLOUD_CREDITS)
  statedValueAmount   Float?
  currency            String                      @default("USD")
  eligibleCountries   String[]                    @default(["IN"])
  eligibleStages      String[]                    @default([])
  status              PerkProgramStatus           @default(ACTIVE)
  verificationStatus  VerificationStatus          @default(PENDING)
  publicationStatus   PublicationStatus           @default(DRAFT)
  startAt             DateTime?
  endAt               DateTime?
  lastCheckedAt       DateTime?
  verifiedAt          DateTime?
  verifiedBy          String?
  verificationNotes   String?
  eligibilityCriteria PerkEligibilityCriterion[]
  sources             PerkSource[]
  savedByUsers        SavedPerk[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([benefitType])
  @@index([status])
  @@index([verificationStatus])
  @@index([publicationStatus])
  @@map("startup_perk_programs")
}

model PerkEligibilityCriterion {
  id            String             @id @default(uuid())
  programId     String
  program       StartupPerkProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  criterionType String             @default("GENERAL")
  description   String
  isMandatory   Boolean            @default(true)
  createdAt     DateTime           @default(now())

  @@index([programId])
  @@map("perk_eligibility_criteria")
}

model PerkSource {
  id              String             @id @default(uuid())
  programId       String
  program         StartupPerkProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  sourceUrl       String
  sourceType      String             @default("PRIMARY")
  contentHash     String?
  isPrimarySource Boolean            @default(true)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())

  @@unique([programId, sourceUrl])
  @@index([sourceUrl])
  @@map("perk_sources")
}

// -------------------------------------------------------------
// Milestone 6: Saved Items, Application Tracking & Alerts
// -------------------------------------------------------------

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum ApplicationStatus {
  SAVED
  APPLYING
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

model UserPreference {
  id                     String                @id @default(uuid())
  userId                 String                @unique
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlertsEnabled     Boolean               @default(true)
  alertFrequency         AlertFrequency        @default(DAILY)
  deadlineAlertDays      Int[]                 @default([7, 2])
  notifyStatusChanges    Boolean               @default(true)
  notifyNewOpportunities Boolean               @default(true)
  notifyPerkExpirations  Boolean               @default(true)
  interestedCategories   OpportunityCategory[] @default([])
  interestedIndustries   IndustrySector[]      @default([])
  unsubscribedAt         DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@map("user_preferences")
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  notes         String?
  createdAt     DateTime    @default(now())

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
  @@map("saved_opportunities")
}

model SavedPerk {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  perkProgramId String
  perkProgram   StartupPerkProgram @relation(fields: [perkProgramId], references: [id], onDelete: Cascade)
  notes         String?
  createdAt     DateTime           @default(now())

  @@unique([userId, perkProgramId])
  @@index([userId])
  @@index([perkProgramId])
  @@map("saved_perks")
}

model ApplicationTracking {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(APPLIED)
  appliedAt     DateTime?
  followUpDate  DateTime?
  privateNotes  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([status])
  @@index([followUpDate])
  @@map("application_tracking")
}

model UserAlertNotification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  alertKey   String
  status     String   @default("SENT")
  sentAt     DateTime @default(now())

  @@unique([userId, alertKey])
  @@index([userId])
  @@map("user_alert_notifications")
}

// -------------------------------------------------------------
// Milestone 7: Co-Founder Matching MVP
// -------------------------------------------------------------

enum CommitmentPreference {
  FULL_TIME
  PART_TIME
  EXPLORING
}

enum WorkLocationPreference {
  REMOTE
  HYBRID
  IN_PERSON
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum FounderProfileStatus {
  ACTIVE
  PAUSED
  HIDDEN
}

enum SkillType {
  OFFERED
  SEEKING
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

model FounderProfile {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  headline         String?
  bio              String?
  currentRole      String?
  desiredRole      String?
  stage            StartupStage           @default(EXPLORING_IDEA)
  primarySector    IndustrySector         @default(SOFTWARE_IT)
  locationCity     String?
  locationState    String?
  countryCode      String                 @default("IN")
  commitment       CommitmentPreference   @default(FULL_TIME)
  workLocation     WorkLocationPreference @default(HYBRID)
  status           FounderProfileStatus   @default(ACTIVE)
  contactEmail     String?
  contactPhone     String?
  linkedinUrl      String?
  githubUrl        String?
  skills           FounderSkill[]
  interests        FounderInterest[]
  sentRequests     ConnectionRequest[]    @relation("sentRequests")
  receivedRequests ConnectionRequest[]    @relation("receivedRequests")
  reportsReceived  ProfileReport[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status])
  @@index([stage])
  @@index([primarySector])
  @@index([commitment])
  @@index([workLocation])
  @@map("founder_profiles")
}

model FounderSkill {
  id          String           @id @default(uuid())
  profileId   String
  profile     FounderProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillName   String
  skillType   SkillType        @default(OFFERED)
  proficiency SkillProficiency @default(INTERMEDIATE)

  @@unique([profileId, skillName, skillType])
  @@index([skillName])
  @@map("founder_skills")
}

model FounderInterest {
  id        String         @id @default(uuid())
  profileId String
  profile   FounderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sector    IndustrySector
  priority  Int            @default(1)

  @@unique([profileId, sector])
  @@map("founder_interests")
}

model ConnectionRequest {
  id               String                  @id @default(uuid())
  requesterId      String
  requester        FounderProfile          @relation("sentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId      String
  recipient        FounderProfile          @relation("receivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  status           ConnectionRequestStatus @default(PENDING)
  introduction     String?
  contactExchanged Boolean                 @default(false)
  responseNote     String?
  createdAt        DateTime                @default(now())
  respondedAt      DateTime?

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
  @@map("connection_requests")
}

model BlockedUser {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("blockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("blockedBy", fields: [blockedUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@map("blocked_users")
}

model ProfileReport {
  id                 String         @id @default(uuid())
  reporterId         String
  reporter           User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reportedProfileId  String
  reportedProfile    FounderProfile @relation(fields: [reportedProfileId], references: [id], onDelete: Cascade)
  category           String         @default("OTHER")
  description        String
  status             ReviewStatus   @default(PENDING)
  createdAt          DateTime       @default(now())

  @@index([status])
  @@map("profile_reports")
}



